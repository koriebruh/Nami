ENGINE_URL=http://localhost:8080

# nami-engine's URL as your cron jobs reach it — shown in heartbeat ping
# URLs. Pings go straight to the engine, not through nami-ui. An absolute
# http:// or https:// URL (a path prefix is fine), with no credentials, query
# string or fragment; anything else makes the heartbeat pages fail with an
# error in the nami-ui log. Empty counts as unset.
PUBLIC_ENGINE_URL=http://localhost:8080
