# nami-engine's private API (its PORT). Only nami-ui calls it: never expose
# that port, since it trusts the client address nami-ui forwards.
ENGINE_URL=http://localhost:8080

# nami-engine's public listener (its PUBLIC_PORT, 8081 by default) as your
# cron jobs and log shippers reach it — shown in heartbeat ping URLs and in the
# log source setup snippets. Pings and log ingest (POST /api/v1/logs) go
# straight to the engine, not through nami-ui, and never to ENGINE_URL: the
# public listener serves only those sessionless endpoints, so it is the one
# engine HTTP port to expose (syslog, when enabled, is a separate public
# ingress on its own TCP/UDP port, see PUBLIC_SYSLOG_ADDRESS below). An
# absolute http:// or https:// URL (a path prefix is fine), with no
# credentials, query string or fragment; anything else makes the heartbeat
# pages fail with an error in the nami-ui log. Empty counts as unset.
PUBLIC_ENGINE_URL=http://localhost:8081

# Where syslog senders reach nami-engine's syslog listener (its SYSLOG_ENABLED
# TCP/UDP port, 5140 by default), shown in the log source setup snippets:
# "host" or "host:port" (an IPv6 address in brackets). Unset, it is the host of
# PUBLIC_ENGINE_URL on port 5140. Anything that is not a host name or IP
# address with an optional port makes the log source page fail with an error
# in the nami-ui log.
# PUBLIC_SYSLOG_ADDRESS=logs.example.com:5140
