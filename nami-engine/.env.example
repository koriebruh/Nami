DATABASE_URL=postgres://nami:nami@localhost:5433/nami
PORT=8080
SMTP_HOST=localhost
SMTP_PORT=1025
# Set to true once served over HTTPS in production — controls the session
# cookie's Secure attribute on both nami-engine (Set-Cookie) and nami-ui
# (the cookie it relays to the browser matches whatever nami-engine sent).
COOKIE_SECURE=false
OAUTH_REDIRECT_BASE_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth
GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
GOOGLE_USERINFO_URL=https://www.googleapis.com/oauth2/v3/userinfo
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_AUTH_URL=https://github.com/login/oauth/authorize
GITHUB_TOKEN_URL=https://github.com/login/oauth/access_token
GITHUB_USERINFO_URL=https://api.github.com/user
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=nami
CLICKHOUSE_PASSWORD=nami
CLICKHOUSE_DATABASE=nami
# Base URL of nami-ui, used for the links in alert emails.
UI_BASE_URL=http://localhost:5173
# Set to false to serve the API without the background uptime checker.
# Accepts true/false/1/0/yes/no/on/off (case-insensitive); anything else
# stops startup rather than guessing.
UPTIME_WORKER_ENABLED=true
# 32 random bytes, base64-encoded. Encrypts monitor secrets at rest (custom
# request header values, basic-auth passwords). Required: the engine refuses
# to start without it. Generate one with `openssl rand -base64 32` and back it
# up — secrets encrypted under a lost key cannot be recovered.
NAMI_ENCRYPTION_KEY=
