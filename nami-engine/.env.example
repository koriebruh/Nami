DATABASE_URL=postgres://nami:nami@localhost:5433/nami
# Postgres pool: its size, how long a request or the uptime worker waits for a
# free connection before failing, and the longest any one statement may run
# (set on every pooled connection). Positive whole numbers; anything else stops
# startup.
DATABASE_MAX_CONNECTIONS=20
DATABASE_ACQUIRE_TIMEOUT_SECS=5
DATABASE_STATEMENT_TIMEOUT_SECS=30
# The private API. nami-ui is its only client: never expose this port (not to
# the internet, not to other machines). It trusts the client address nami-ui
# sends in X-Forwarded-For, which anyone reaching it directly could forge.
PORT=8080
# The public listener: only the endpoints outside clients call without a
# session (heartbeat pings and log ingest, POST /api/v1/logs, now; OTLP and
# Sentry ingest later). This is the one port to expose to cron jobs, log
# shippers and other machines; nami-ui's PUBLIC_ENGINE_URL points here. Must
# differ from PORT.
PUBLIC_PORT=8081
SMTP_HOST=localhost
SMTP_PORT=1025
# How the SMTP connection is protected: none (plain, for Mailpit in
# development), starttls (upgrade required, usually port 587) or tls (TLS from
# the first byte, usually port 465). Certificates are checked against the
# system's trusted roots.
SMTP_TLS=none
# Optional SMTP login; set both or neither. The password is never logged.
SMTP_USERNAME=
SMTP_PASSWORD=
# With a login and SMTP_TLS=none, the password would travel in the clear: the
# engine refuses to start that way unless SMTP_HOST is this machine
# (localhost, 127.0.0.0/8, ::1) or this is true (a relay on a network you
# trust). A container's service name, such as mailpit, is another machine.
SMTP_ALLOW_PLAINTEXT_AUTH=false
# The sender of every email (default: Nami <noreply@nami.local>). Quote any
# value with spaces or < >: an unquoted one is a line that does not parse, and
# the engine refuses to start on it.
SMTP_FROM="Nami <noreply@nami.local>"
# Set to true once served over HTTPS in production — controls the session
# cookie's Secure attribute on both nami-engine (Set-Cookie) and nami-ui
# (the cookie it relays to the browser matches whatever nami-engine sent).
COOKIE_SECURE=false
OAUTH_REDIRECT_BASE_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth
GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
GOOGLE_USERINFO_URL=https://www.googleapis.com/oauth2/v3/userinfo
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_AUTH_URL=https://github.com/login/oauth/authorize
GITHUB_TOKEN_URL=https://github.com/login/oauth/access_token
GITHUB_USERINFO_URL=https://api.github.com/user
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=nami
CLICKHOUSE_PASSWORD=nami
CLICKHOUSE_DATABASE=nami
# Base URL of nami-ui, used for the links in alert emails.
UI_BASE_URL=http://localhost:5173
# Set to false to serve the API without the background uptime checker.
# Accepts true/false/1/0/yes/no/on/off (case-insensitive); anything else
# stops startup rather than guessing.
UPTIME_WORKER_ENABLED=true
# RFC 5424 syslog ingestion over TCP and UDP (off by default). A public
# ingress like PUBLIC_PORT: expose these ports only to the machines that ship
# logs. Frames authenticate with the structured-data element
# [nami token="<source token>"].
SYSLOG_ENABLED=false
SYSLOG_TCP_PORT=5140
SYSLOG_UDP_PORT=5140
# The most log sources one project may have (default 50); creating one more
# is refused with 409. Each source gets its own share of the ingest limits, so
# this caps what one project can claim. A positive whole number.
MAX_SOURCES_PER_PROJECT=50
# 32 random bytes, base64-encoded. Encrypts monitor secrets at rest (custom
# request header values, basic-auth passwords). Required: the engine refuses
# to start without it. Generate one with `openssl rand -base64 32` and back it
# up — secrets encrypted under a lost key cannot be recovered.
NAMI_ENCRYPTION_KEY=
# Ping monitors use unprivileged ICMP sockets (no root). On Linux, and so in
# Docker, the engine's group must be inside net.ipv4.ping_group_range:
#   sudo sysctl -w net.ipv4.ping_group_range="0 2147483647"
# or, for a container: sysctls: ["net.ipv4.ping_group_range=0 2147483647"]

# RDAP service for domain-expiry monitors; rdap.org redirects each lookup to
# the registry's own RDAP server.
RDAP_BASE_URL=https://rdap.org
